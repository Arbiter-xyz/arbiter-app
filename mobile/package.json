{
  "name": "arbiter-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Capacitor shell wrapping the worker console's Vite build (issue #56).",
  "scripts": {
    "build:web": "npm --prefix ../app run build",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "npm run build:web && cap sync",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
