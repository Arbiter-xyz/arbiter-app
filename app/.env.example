VITE_BACKEND_URL=http://localhost:4000
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_USDC_ASSET_CODE=USDC
VITE_USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
VITE_ORACLE_CONTRACT_ID=
# Optional: Crisp website ID for the in-app live support chat (issue #62).
VITE_CRISP_WEBSITE_ID=
# VAPID public key for web push subscriptions.
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=

# Feature flags (see src/flags.js). Either point at an Unleash Frontend
# API/Edge/proxy (URL + client key), or leave unset to fall back to a
# static JSON file at VITE_FLAGS_URL (default /flags.json).
VITE_UNLEASH_URL=
VITE_UNLEASH_CLIENT_KEY=
VITE_UNLEASH_APP_NAME=arbiter-app
VITE_FLAGS_URL=/flags.json

# Opt-in session replay (PostHog) for debugging real user issues. Off by
# default: nothing loads unless VITE_SESSION_REPLAY_POSTHOG_KEY is set, and
# the admin console additionally requires VITE_SESSION_REPLAY_ADMIN=true.
VITE_SESSION_REPLAY_POSTHOG_KEY=
VITE_SESSION_REPLAY_HOST=https://us.i.posthog.com
VITE_SESSION_REPLAY_ADMIN=false

# WalletConnect project id used by dashboard.js when wiring wallet adapters.
VITE_WALLETCONNECT_PROJECT_ID=
