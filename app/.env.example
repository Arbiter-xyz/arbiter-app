VITE_BACKEND_URL=http://localhost:4000
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_USDC_ASSET_CODE=USDC
VITE_ORACLE_CONTRACT_ID=

# Session replay (off unless a key is set). See README "Session replay".
VITE_SESSION_REPLAY_POSTHOG_KEY=
VITE_SESSION_REPLAY_HOST=https://us.i.posthog.com
VITE_SESSION_REPLAY_ADMIN=false

# Runtime feature flags (app/src/flags.js). Values are fetched at runtime, not baked in.
# Static JSON source (default /flags.json, served from public/); edit it to toggle without a rebuild.
VITE_FLAGS_URL=
# Optional Unleash Frontend API / Edge endpoint, e.g. https://unleash.example.com/api/frontend
VITE_UNLEASH_URL=
VITE_UNLEASH_CLIENT_KEY=
VITE_UNLEASH_APP_NAME=arbiter-app
