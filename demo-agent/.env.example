BACKEND_URL=http://localhost:4000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ORACLE_CONTRACT_ID=

# Used by sponsored-demo.js and scenarios/timeout-refund.js when waiting for
# refund_timeout(). Match the timeout configured in the deployed contract;
# for a faster testnet proof, use that test deployment's shorter timeout.
TIMEOUT_LEDGERS=100

# Used only by sponsored-demo.js to run the permissionless timeout-refund proof.
PROVE_TIMEOUT_REFUND=false

# Funded testnet key standing in for a browser wallet (ask.js can't use a
# browser extension headlessly, so it signs directly with this secret).
DEMO_PAYER_SECRET=

# Optional — defaults to "standard" / no category.
TIER=standard
CATEGORY=

# Used only by worker-sim.js.
WORKER_ID=demo-worker-1
WORKER_ANSWER=42
WORKER_CATEGORIES=
# Optional: a funded testnet secret. Setting this makes worker-sim.js use a
# real signable Stellar address as its workerId (instead of an arbitrary
# string) and unlocks the staking/auto-withdraw demo below.
WORKER_SECRET=
DO_STAKE=false
STAKE_AMOUNT_STROOPS=1000000
AUTO_WITHDRAW=false
WITHDRAW_INTERVAL_MS=30000

# Used only by sponsored-demo.js — a separately-funded USDC holder that pays
# its own network fee to seed a fresh, still-XLM-less keypair with test USDC.
FUNDING_PAYER_SECRET=

# Used only by sponsored-demo.js — set to "true" to also run the
# permissionless timeout-refund proof (a third party reclaims funds after
# TIMEOUT_LEDGERS elapse). Skipped by default.
PROVE_TIMEOUT_REFUND=false

# Shared by lib/stellar.js and lib/stellar-mock.js. USDC_ASSET_CODE/ISSUER
# default to the public testnet USDC issuer; TIMEOUT_LEDGERS defaults to 100.
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
TIMEOUT_LEDGERS=100

# Used only by scenarios/quorum.js — how many in-process workers to bring
# online for the quorum demo. Defaults to 3.
SCENARIO_WORKERS=3

# Used only by sandbox-demo.js — how long to wait for the sandboxed run
# before timing out, in ms. Defaults to 60000.
SANDBOX_TIMEOUT_MS=60000

# Used only by sandbox-ask.js (the Slack/Discord bot front-end). Sandbox-only:
# no payer secret is used and no real payment is possible from the bot until a
# custody model is explicitly chosen and documented.
# Per-user rate limiting (keyed by chat user id, not the bot process).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
